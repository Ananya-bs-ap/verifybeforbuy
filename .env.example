# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000 in AI Studio)
PORT="3000"

# SUPABASE (Optional - for persistent cloud history and user accounts)
# The application functions seamlessly in demo/local mode when these are unset.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# BARCODE PRODUCT DATABASES (Optional server-side configuration — not required)
# Open Food Facts, Open Beauty Facts, Open Products Facts, and the UPCitemdb trial
# endpoint work out of the box with no API keys and a default 5000ms timeout.
# Optional overrides (set only if using a paid UPCitemdb plan or custom timeout):
#   UPCITEMDB_API_KEY
#   UPCITEMDB_KEY_TYPE (defaults to "3scale")
#   BARCODE_LOOKUP_TIMEOUT_MS (defaults to 5000)
